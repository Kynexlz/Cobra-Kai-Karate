```lua
getgenv().RAYFIELD_SECURE = true

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Orbit | Cobra Kai",
    LoadingTitle = "Orbit | Cobra Kai",
    LoadingSubtitle = "Scripted by Kai | Edited by MobileExploits",

    ConfigurationSaving = {
        Enabled = false,
        FolderName = "Orbit",
        FileName = "CobraKai"
    },

    Discord = {
        Enabled = false,
        Invite = "",
        RememberJoins = false
    },

    KeySystem = false,
})

local StatTab = Window:CreateTab("Stat", nil)

local Event = game:GetService("ReplicatedStorage")
    :WaitForChild("BridgeNet2")
    :WaitForChild("dataRemoteEvent")

local PullUpEnabled = false
local BenchPressEnabled = false
local statLoopRunning = false
local unloaded = false

local function startStatLoop()
    if statLoopRunning or unloaded then
        return
    end

    statLoopRunning = true

    task.spawn(function()
        while not unloaded and (PullUpEnabled or BenchPressEnabled) do
            if PullUpEnabled then
                Event:FireServer({
                    nil,
                    "&"
                })
                task.wait(0.1)
            end

            if BenchPressEnabled then
                Event:FireServer({
                    nil,
                    "%"
                })
                task.wait(0.1)
            end
        end

        statLoopRunning = false

        if not unloaded and (PullUpEnabled or BenchPressEnabled) then
            startStatLoop()
        end
    end)
end

StatTab:CreateButton({
    Name = "Unload Orbit",
    Callback = function()
        unloaded = true
        PullUpEnabled = false
        BenchPressEnabled = false

        Rayfield:Destroy()
    },
})

StatTab:CreateSection("Gamepass")

StatTab:CreateToggle({
    Name = "Pull Up",
    CurrentValue = false,
    Flag = "PullUp",
    Callback = function(enabled)
        PullUpEnabled = enabled

        if enabled then
            startStatLoop()
        end
    end,
})

StatTab:CreateToggle({
    Name = "Bench Press",
    CurrentValue = false,
    Flag = "BenchPress",
    Callback = function(enabled)
        BenchPressEnabled = enabled

        if enabled then
            startStatLoop()
        end
    end,
})
```
